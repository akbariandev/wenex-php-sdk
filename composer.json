{
    "name": "wenex-platform/php-sdk",
    "description": "PHP SDK for the Wenex platform",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://wenex.org/",
    "authors": [
        {
            "name": "Wenex PHP developers",
            "homepage": "https://github.com/orgs/wenex-org/teams/php-developers"
        }
    ],
    "scripts": {
        "format": "php-cs-fixer fix -v",
        "analyze": "phpstan analyse --memory-limit=256M",
        "test-unit": "phpunit --testsuite Unit",
        "common:clone": "bash ./scripts/common-clone.sh",
        "common:update": "bash ./scripts/common-update.sh"
    },
    "autoload": {
        "psr-4": {
            "WenexPlatform\\PhpSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WenexPlatform\\PhpSdk\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/common",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.1",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.1",
        "guzzlehttp/guzzle": "^7.10",
        "wenex-platform/php-sdk-common": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1"
    }
}
